// Переменные для хранения самолётных углов ориентации
float yaw, pitch, roll;
// Переменная для хранения частоты выборок фильтра
float sampleRate = 100;


int receivedData[5]; // Массив для получения данных

uint8_t pipe; // Переменная для определения номера трубы по которой принят сигнал

void setup() {
  // pinmode(rxPIN, INPUT);
  // pinmode(txPIN, OUTPUT);
 // Открываем последовательный порт
 Serial.begin(9600);
 BluetoothSerial.begin(9600); // открываем порт блютуза
 // Выводим сообщение о начале инициализации
 // Инициализируем гироскоп
 gyroscope.begin();
 // Инициализируем акселерометр
 accelerometer.begin();
 // Инициализируем фильтр
 filter.begin();
 // Выводим сообщение об удачной инициализации
 radio.begin(); // Инициализация радиомодуля
 radio.setChannel(112); // Выбираем канал для радиомодуля (Должен совподать с каналом передачика)
 radio.setDataRate(RF24_2MBPS); // Выбираем скорость приема радиомодуля (Должен совподать с каналом передачика)
 radio.setPALevel(RF24_PA_MIN); // Выбираем мощность радиомодуля (Должен совподать с каналом передачика)
 radio.openReadingPipe(1, 0x0123456789LL); // Выбираем какую трубу (из 6 слушать) и по какой трубе
 radio.startListening(); // Ставим радиомодуль на прослушивание 

 Serial.println(BluetoothSerial.available());
}
